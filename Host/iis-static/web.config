<?xml version="1.0" encoding="UTF-8"?>
<!-- ALTERNATIVE LAYOUT, NOT TESTED (no IIS available to test it): Windows App Service without any app process.
     IIS itself serves the build's precompressed files: X.br for X when the browser accepts br (else X.gz), with
     Content-Encoding set by outbound rules. Based on Microsoft's sample web.config for Blazor WebAssembly on IIS
     (https://learn.microsoft.com/aspnet/core/blazor/host-and-deploy/webassembly/iis, "Brotli and Gzip compression"),
     adapted to this site: two apps under /honest/ and /extreme/, the .bin bundle, robots header, IIS compression off.
     Deploy: the assembled site (tools/assemble-site.mjs ... -host appservice) at site\wwwroot plus this file. -->
<configuration>
  <system.webServer>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".dll" /><remove fileExtension=".json" /><remove fileExtension=".wasm" /><remove fileExtension=".bin" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".js.br" mimeType="text/javascript" />
      <mimeMap fileExtension=".wasm.br" mimeType="application/wasm" />
      <mimeMap fileExtension=".bin.br" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json.br" mimeType="application/json" />
      <mimeMap fileExtension=".html.br" mimeType="text/html" />
      <mimeMap fileExtension=".txt.br" mimeType="text/plain" />
      <mimeMap fileExtension=".js.gz" mimeType="text/javascript" />
      <mimeMap fileExtension=".wasm.gz" mimeType="application/wasm" />
      <mimeMap fileExtension=".bin.gz" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json.gz" mimeType="application/json" />
      <mimeMap fileExtension=".html.gz" mimeType="text/html" />
      <mimeMap fileExtension=".txt.gz" mimeType="text/plain" />
    </staticContent>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
    <rewrite>
      <outboundRules rewriteBeforeCache="true">
        <rule name="Add Vary Accept-Encoding" preCondition="PreCompressedFile" enabled="true">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <rule name="Add Encoding Brotli" preCondition="PreCompressedBrotli" enabled="true" stopProcessing="true">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="Add Encoding Gzip" preCondition="PreCompressedGzip" enabled="true" stopProcessing="true">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="gzip" />
        </rule>
        <preConditions>
          <preCondition name="PreCompressedFile"><add input="{REQUEST_FILENAME}" pattern="\.(gz|br)$" /></preCondition>
          <preCondition name="PreCompressedBrotli"><add input="{REQUEST_FILENAME}" pattern="\.br$" /></preCondition>
          <preCondition name="PreCompressedGzip"><add input="{REQUEST_FILENAME}" pattern="\.gz$" /></preCondition>
        </preConditions>
      </outboundRules>
      <rules>
        <rule name="SPA fallback honest" stopProcessing="false">
          <match url="^honest/[^.]*$" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" /></conditions>
          <action type="Rewrite" url="honest/index.html" />
        </rule>
        <rule name="SPA fallback extreme" stopProcessing="false">
          <match url="^extreme/[^.]*$" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" /></conditions>
          <action type="Rewrite" url="extreme/index.html" />
        </rule>
        <rule name="Rewrite brotli file" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
            <add input="{REQUEST_FILENAME}" pattern="\.(js|dll|json|wasm|bin|html|txt)$" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.br" />
        </rule>
        <rule name="Rewrite gzip file" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="gzip" />
            <add input="{REQUEST_FILENAME}" pattern="\.(js|dll|json|wasm|bin|html|txt)$" />
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.gz" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
