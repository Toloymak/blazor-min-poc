<?xml version="1.0" encoding="utf-8"?>
<!-- Windows App Service: IIS + ASP.NET Core Module start the host out-of-process (works for framework-dependent,
     self-contained and Native AOT builds). build/publish replaces PROCESS_PATH / ARGUMENTS. IIS compression is turned off
     so IIS never touches our precompressed responses. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="PROCESS_PATH" arguments="ARGUMENTS" hostingModel="outofprocess" stdoutLogEnabled="false" />
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
