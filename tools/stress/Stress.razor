@* Stress page for native-stub tracing. NOT part of the shipped app: tools/make-stress.sh copies Extreme to ExtremeStress and adds it. *@
@inject IJSRuntime JS
<h1>Stress</h1>
<button @onclick="Run">Run</button>
<p id="result">@result</p>
@code {
    string result = "";
    async Task Run()
    {
        var log = new System.Text.StringBuilder();
        int ok = 0;
        void Step(string name, Func<object?> f) { try { log.Append(name).Append('=').Append(f()).Append(' '); ok++; } catch (Exception e) { log.Append(name).Append("!!").Append(e.GetType().Name).Append(' '); } }
        Step("catch", () => { try { throw new InvalidOperationException("boom"); } catch (InvalidOperationException e) { return e.Message; } });
        Step("nested", () => { try { try { int.Parse("x"); } finally { log.Append("fin "); } } catch (FormatException) { return "fmt"; } return "?"; });
        Step("gc", () => { var keep = new List<byte[]>(); for (int i = 0; i < 2000; i++) { keep.Add(new byte[1024 * (i % 64 + 1)]); if (i % 100 == 0) keep.Clear(); } GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect(); return GC.CollectionCount(0) > 0; });
        Step("fmt", () => $"{123.456:F2}|{1e21}|{-0.0}|{decimal.Divide(1, 3)}|{int.MaxValue:N0}|{(Half)1.5}|{3.14f}|{ulong.MaxValue:X}");
        Step("parse", () => double.Parse("1.25e3") + int.Parse("-42") + (double)decimal.Parse("7.5") + long.Parse("123456789012"));
        Step("now", () => DateTime.Now.ToString("O").Length + DateTime.UtcNow.Year + DateTimeOffset.Now.Offset.Minutes);
        Step("dtparse", () => DateTime.Parse("2026-11-17T10:20:30Z").ToUniversalTime().Hour + TimeSpan.Parse("01:02:03").TotalSeconds);
        Step("guid", () => Guid.NewGuid().ToString().Length + Guid.Parse("01234567-89ab-cdef-0123-456789abcdef").GetHashCode() * 0);
        Step("linq", () => Enumerable.Range(0, 1000).Where(i => i % 3 == 0).Select(i => i * 2).OrderByDescending(i => i).Take(5).Sum());
        Step("dict", () => { var d = new Dictionary<string, int>(); for (int i = 0; i < 5000; i++) d["k" + i] = i; return d.Count + d["k77"]; });
        Step("string", () => string.Compare("abc", "ABD", StringComparison.OrdinalIgnoreCase) + "Hello".ToUpperInvariant() + string.Join(",", "a b c".Split(' ')));
        Step("generic", () => new List<(int, string)> { (1, "a") }.ConvertAll(t => t.Item2 + t.Item1)[0]);
        Step("delegate", () => { Func<int, int> f = x => x + 1; Action<int>? a = null; a += _ => { }; a(1); return f.Invoke(1); });
        await Task.Delay(10); log.Append("delay "); ok++;
        try { await JS.InvokeAsync<string>("getData", "no-such-file.json"); log.Append("http?? "); }
        catch (JSException) { log.Append("httpfail=caught "); ok++; }
        result = $"STRESS OK {ok} {log}";
    }
}
