<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Honest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- TrimMode=full also trims the app assembly. The Router finds pages by reflection and RouteView
         gets the layout as a Type, so their constructors were removed ("CtorNotLocated, Honest.Layout.MainLayout").
         Rooting our own (tiny) assembly keeps every component; the framework is still fully trimmed. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>
</Project>
